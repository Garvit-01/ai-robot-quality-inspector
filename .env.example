# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
# Nebius Token Factory API key. Starts with "v1."
# This is NOT your Nebius Cloud login token — mint it in the Token Factory console.
NEBIUS_TOKEN_FACTORY_KEY=

# Planner (Nemotron, tool calling). Base URL for Token Factory's OpenAI-compatible API.
PLANNER_BASE_URL=https://api.tokenfactory.nebius.com/v1/
PLANNER_API_KEY=
PLANNER_MODEL_ID=

# Verifier (vision model). Tier 1 = hosted zero-shot model.
# Tier 2 = our fine-tuned Cosmos-Reason1-7B on a Nebius endpoint.
# Swapping tiers must only ever require changing these three values.
VERIFIER_BASE_URL=https://api.tokenfactory.nebius.com/v1/
VERIFIER_API_KEY=
VERIFIER_MODEL_ID=
